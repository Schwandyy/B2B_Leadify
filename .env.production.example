# ============================================================================
# Production-Konfiguration für die VM. Diese Datei dient nur als Vorlage.
# Auf der VM nach /opt/b2b-leadify/.env kopieren und Werte setzen.
# Niemals in Git committen.
# ============================================================================

# --- Postgres (Docker-Compose-internes Netz) -------------------------------
POSTGRES_USER=product2lead
POSTGRES_DB=product2lead
# Mit `openssl rand -base64 32` generieren.
POSTGRES_PASSWORD=changeme

# --- Auth ------------------------------------------------------------------
# Mit `openssl rand -base64 32` generieren — JWT-Cookie-Signing.
AUTH_SECRET=changeme

# --- App-URL ---------------------------------------------------------------
# Externe URL über die die App erreichbar ist. Wichtig für Cookie-Domain
# und absolute Links in E-Mails.
NEXT_PUBLIC_APP_URL=https://leads.az-delivery.com

# --- Bind-Adresse ----------------------------------------------------------
# Wenn euer Caddy auf derselben VM läuft: 127.0.0.1
# Wenn Caddy auf anderer VM und nur dessen IP soll zugreifen können:
#   0.0.0.0 hier setzen + ufw nur für Caddy-IP öffnen.
APP_BIND=127.0.0.1

# --- AI --------------------------------------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL_OPENAI=gpt-4o-mini

# --- Research --------------------------------------------------------------
RESEARCH_PROVIDER=crawler

# --- Cron (Inventory-Sync) -------------------------------------------------
# Mit `openssl rand -base64 32` generieren. Wird vom systemd-Timer als
# Authorization: Bearer ... mitgeschickt.
CRON_SECRET=changeme

# --- Registration-Restriction ----------------------------------------------
# Nur Email-Adressen mit dieser Domain dürfen sich registrieren.
REGISTER_ALLOWED_DOMAIN=az-delivery.com
