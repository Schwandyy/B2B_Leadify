# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/product2lead?schema=public"

# Auth
# Generate via: openssl rand -base64 32
AUTH_SECRET="change-me-in-production-32bytes-minimum-please-rotate"

# Public app URL (used for absolute URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3100"

# AI providers — leave empty to use the deterministic mock implementations
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_PROVIDER="mock"   # "mock" | "openai" | "anthropic"
AI_MODEL_OPENAI="gpt-4o-mini"
AI_MODEL_ANTHROPIC="claude-haiku-4-5-20251001"

# Research engine: "mock" (12 fictitious B2B companies) or "crawler"
# (DuckDuckGo HTML search + own polite imprint crawler, no API key needed).
# DSGVO: crawler respects robots.txt, rate-limits per domain, only stores
# generic role e-mails (info@, vertrieb@, ...).
RESEARCH_PROVIDER="mock"

# Upload dir for MVP (relative to project root)
UPLOAD_DIR="public/uploads"
